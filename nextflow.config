// Nextflow configuration. Pipeline parameters live in the YAML passed via -params-file.

docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'

// Mount the project directory, the work directory, and any additional dirs listed under
// `bind_mounts:` in the params YAML (e.g. wherever your FASTAs / fastqs live, since they're
// passed as `val` strings). The work dir is mounted because BIGWIG's chrom.sizes is a `val`
// too, and it lives in INDEX_REF's work dir whenever the pipeline indexed the reference
// itself; -w outside the project dir would otherwise be invisible to the container.
// Docker uses `-v host:container`; Singularity/Apptainer use `-B host:container`.
process.containerOptions = {
    def flag = (workflow.containerEngine in ['singularity', 'apptainer']) ? '-B' : '-v'
    def dirs = [baseDir.toString(), workflow.workDir.toString()] + (params?.bind_mounts ?: [])
    dirs.unique().collect { "${flag} ${it}:${it}" }.join(' ')
}

process {
    cpus = 2

    withName: TRIM               { container = 'ghcr.io/eit-gbi/nf-mod-fastp:latest' }
    withName: BWA_ALIGN_NSORT    { container = 'ghcr.io/eit-gbi/nf-mod-bwa:latest' }
    withName: INDEX_REF          { container = 'ghcr.io/eit-gbi/nf-mod-bwa:latest' }
    withName: MAKE_WT_REF        { container = 'ghcr.io/eit-gbi/recoding-alignment-utils:latest' }
    withName: BIGWIG             { container = 'ghcr.io/eit-gbi/nf-mod-bedtools:latest' }
    withName: COMPETITIVE_ASSIGN { container = 'ghcr.io/eit-gbi/recoding-alignment-utils:latest' }
    withName: VARIANTS           { container = 'ghcr.io/eit-gbi/recoding-alignment-utils:latest' }
    withName: RECODING_LANDSCAPE { container = 'ghcr.io/eit-gbi/recoding-alignment-utils:latest' }
    withName: AGGREGATE_ANNDATA  { container = 'ghcr.io/eit-gbi/recoding-alignment-utils:latest' }
}

profiles {
    cluster {
        process.executor       = 'slurm'
        // apptainer.enabled    = true
        // apptainer.autoMounts = true
        // apptainer.cacheDir   = '/mnt/lustre/containers/.staging/nf/cache/'
        docker.enabled         = false


        // How many jobs Nextflow keeps in the SLURM queue at once. The grid default
        // is 100, and that — not the cluster — is what caps how many samples run in
        // parallel; a 385-sample run is ~2700 jobs in total. Raise queueSize further
        // if the partition still has idle cores; extra jobs simply sit PENDING.
        // submitRateLimit keeps us from hammering slurmctld while the queue fills.
        executor {
            queueSize       = 100
            submitRateLimit = '50/1min'
        }

        // Per-job resources, cluster-only: locally these would turn into docker
        // --memory caps. `time` is deliberately not set, so the partition's default
        // time limit keeps applying exactly as it did before. Memory is a closure so
        // a retry asks for more than the attempt that died.
        //
        // cpus for the four params-driven processes comes from `threads` in the
        // params file. Lowering it runs MORE samples at once for the same number of
        // cores — worth trying if the queue is full but throughput is disappointing.
        process {
            // Retry the transient/kill exit codes (OOM, time limit, node failure);
            // anything else is a real bug and should stop the run.
            errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'terminate' }
            maxRetries    = 2

            withName: TRIM               { memory = { 4.GB * task.attempt } }
            withName: BWA_ALIGN_NSORT    { memory = { 8.GB * task.attempt } }
            withName: COMPETITIVE_ASSIGN { memory = { 8.GB * task.attempt } }
            withName: VARIANTS           { cpus = 2; memory = { 4.GB * task.attempt } }

            // Single-threaded steps: 1 cpu each, so they don't hold 2 cores apiece.
            withName: BIGWIG             { cpus = 1; memory = { 4.GB * task.attempt } }
            withName: RECODING_LANDSCAPE { cpus = 1; memory = { 4.GB * task.attempt } }
            withName: MAKE_WT_REF        { cpus = 1; memory = { 4.GB * task.attempt } }
            withName: INDEX_REF          { cpus = 1; memory = { 4.GB * task.attempt } }
            // Holds every sample's dataframe at once: measured ~0.6 GB at 80 samples,
            // scaling at ~5 MB/sample, so ~2.2 GB at 385. 8 GB is headroom.
            withName: AGGREGATE_ANNDATA  { cpus = 1; memory = { 8.GB * task.attempt } }
        }

        // If the scheduler itself becomes the bottleneck (thousands of short jobs),
        // batch them into SLURM job arrays instead of raising queueSize further:
        //   process.array = 100
    }
}

dag.enabled = false
